# ==============================================================================
# Vercel Environment Variables — Kutumba Ashirvada Sadassu 2026
# ==============================================================================
# In Vercel: Project → Settings → Environment Variables
# Add each variable for: Production, Preview, and Development
# ==============================================================================

# REQUIRED — Backend database (Firestore)
# Copy the ENTIRE Firebase service account JSON as ONE line from:
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT=

# REQUIRED — Admin login security
JWT_SECRET=ngm-sadassu-2026-super-secure-jwt-key
ADMIN_USERNAME=admin1
ADMIN_PASSWORD=admin1

# OPTIONAL — Frontend Firebase client (for admin agenda realtime, etc.)
# Get these from Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# NOTES:
# - Do NOT add VITE_ prefix to FIREBASE_SERVICE_ACCOUNT (that is server-only)
# - FIREBASE_SERVICE_ACCOUNT must be valid JSON with private_key and client_email
# - After adding variables, redeploy the project in Vercel
