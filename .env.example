# ==============================================================================
# Vercel Environment Variables — Kutumba Ashirvada Sadassu 2026
# ==============================================================================
# In Vercel: Project → Settings → Environment Variables
# Add each variable for: Production, Preview, and Development
# ==============================================================================

# REQUIRED — Backend database (Firestore) — pick ONE method:
#
# Method A (easiest in Vercel UI): set these 3 separate variables:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
#
# Method B: one JSON variable (paste ONLY the JSON value, no "FIREBASE_SERVICE_ACCOUNT=" prefix):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN..."}
#
# NOTE: In Vercel, when you click Edit on a secret variable the value box looks EMPTY.
# That is normal — Vercel hides secrets. They are still saved. Check /api/status after deploy.

# REQUIRED — Admin login security
JWT_SECRET=ngm-sadassu-2026-super-secure-jwt-key
ADMIN_USERNAME=admin1
ADMIN_PASSWORD=admin1

# OPTIONAL — Frontend Firebase client (for admin agenda realtime, etc.)
# Get these from Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# NOTES:
# - Do NOT add VITE_ prefix to FIREBASE_SERVICE_ACCOUNT (that is server-only)
# - FIREBASE_SERVICE_ACCOUNT must be valid JSON with private_key and client_email
# - After adding variables, redeploy the project in Vercel
